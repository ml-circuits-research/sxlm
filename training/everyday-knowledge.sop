@v84 kernel.value.record "url" "https://www.nps.gov/teachers/classrooms/desert-adaptations.htm" "title" "Desert Adaptations" "accessed" "2026-09-08"
@v85 kernel.value.record "id" "336cdd4c0a90e1939d851b1bdf75aa34df5626e18d4a4a3119ff1ff762976c38" "text" "Plants need water to survive. This claim concerns the water requirement, not a requirement for constant watering." "reference" $v84 "authorship" "Agent-authored paraphrase of the cited source."
