@v693 kernel.value.record "id" "vertebrates" "publisher" "National Park Service" "title" "Vertebrate Fossils" "url" "https://www.nps.gov/subjects/fossils/vertebrate-fossils.htm" "support" "Vertebrates are animals with backbones, including mammals, birds, reptiles, amphibians and fish." "accessed" "2026-09-08"
@v694 kernel.value.record "id" "dolphins" "publisher" "NOAA" "title" "Are dolphins fish?" "url" "https://oceanservice.noaa.gov/facts/dolphin.html" "support" "Dolphins are mammals and are not fish." "accessed" "2026-09-08"
@v695 kernel.value.record "id" "invertebrates" "publisher" "National Park Service" "title" "Invertebrates" "url" "https://www.nps.gov/grca/learn/nature/invertebrates.htm" "support" "Insects and spiders are invertebrates. Adult insects have six legs." "accessed" "2026-09-08"
@v696 kernel.value.record "id" "plants" "publisher" "National Park Service" "title" "Explore Plants by Form" "url" "https://www.nps.gov/dena/learn/nature/plants-by-form.htm" "support" "Trees and shrubs are plant forms; conifers are cone-producing plants." "accessed" "2026-09-08"
@v697 kernel.value.record "id" "planets" "publisher" "NASA" "title" "About the Planets" "url" "https://science.nasa.gov/solar-system/planets/" "support" "The eight named solar-system planets include four inner terrestrial planets; Pluto is a dwarf planet." "accessed" "2026-09-08"
@v698 kernel.value.record "id" "sun" "publisher" "NASA" "title" "Sun Facts" "url" "https://science.nasa.gov/sun/facts/" "support" "The Sun is the star of our solar system." "accessed" "2026-09-08"
@v699 kernel.value.record "id" "orbits" "publisher" "NASA" "title" "Our Solar System" "url" "https://science.nasa.gov/resource/our-solar-system-2/" "support" "The eight listed planets orbit the Sun; the Moon orbits Earth. The dated moon census on this page is not used." "accessed" "2026-09-08"
@v700 kernel.value.record "id" "water" "publisher" "United States Geological Survey" "title" "Water cycle" "url" "https://www.usgs.gov/water-science-school/water-cycle" "support" "Water occurs as liquid water, solid ice and gaseous water vapor." "accessed" "2026-09-08"
@v701 kernel.value.record "id" "geometry" "publisher" "Common Core State Standards Initiative" "title" "Grade 3 Geometry" "url" "https://www.thecorestandards.org/Math/Content/3/G/" "support" "Squares, rectangles and rhombuses belong to the quadrilateral category." "accessed" "2026-09-08"
@v702 kernel.value.record "id" "shapes" "publisher" "Maths Is Fun" "title" "Quadrilaterals" "url" "https://www.mathsisfun.com/quadrilaterals.html" "support" "Inclusive Euclidean plane definitions: a square is a rectangle and a rhombus; quadrilaterals are polygons." "accessed" "2026-09-08"
@v703 kernel.value.record "id" "units" "publisher" "BIPM" "title" "SI base units" "url" "https://www.bipm.org/en/measurement-units/si-base-units" "support" "The second, metre and kilogram measure time, length and mass respectively." "accessed" "2026-09-08"
@v704 kernel.value.record "id" "time" "publisher" "NIST" "title" "Units Outside the SI" "url" "https://www.nist.gov/pml/special-publication-811/nist-guide-si-chapter-5-units-outside-si" "support" "The duration units minute, hour and day equal 60 seconds, 60 minutes and 24 hours. Civil-clock anomalies are outside these duration definitions." "accessed" "2026-09-08"
@v705 kernel.value.record "id" "chair" "publisher" "Smithsonian Institution" "title" "Chair" "url" "https://americanhistory.si.edu/collections/object/nmah_317224" "support" "The collection classifies a chair as furniture. This supports the lexical category; not every chair shares this specimen material." "accessed" "2026-09-08"
@v706 kernel.value.record "id" "spoon" "publisher" "Smithsonian Institution" "title" "Synoptic Series of Objects" "url" "https://repository.si.edu/bitstream/handle/10088/15221/USNMP-60_2404_1922.pdf" "support" "A spoon is a utensil. No historical-cultural ranking in the source is used." "accessed" "2026-09-08"
@v707 kernel.value.record "id" "france" "publisher" "European Union" "title" "France: EU country" "url" "https://european-union.europa.eu/principles-countries-history/eu-countries/france_en" "support" "France is a country with Paris as its capital. No claim that all French territory is in Europe is encoded." "accessed" "2026-09-08"
@v708 kernel.value.record "id" "italy" "publisher" "European Union" "title" "Italy: EU country" "url" "https://european-union.europa.eu/principles-countries-history/eu-countries/italy_en" "support" "Italy is a country with Rome as its capital." "accessed" "2026-09-08"
@v709 kernel.value.record "id" "domestic-dog" "publisher" "Smithsonian Institution" "title" "Domestic Dog" "url" "https://qrius.si.edu/browse/object/10026879" "support" "Canis lupus familiaris is classified within Mammalia. Only taxonomic classification is used." "accessed" "2026-09-08"
@v710 kernel.value.record "id" "domestic-cat" "publisher" "Smithsonian Institution" "title" "Domestic Cat" "url" "https://qrius.si.edu/browse/object/10841947" "support" "Felis catus is classified within Mammalia. Only taxonomic classification is used." "accessed" "2026-09-08"
@v711 kernel.value.record "id" "hymenoptera" "publisher" "National Park Service" "title" "Insects and Other Arthropods" "url" "https://www.nps.gov/colm/learn/nature/insects.htm" "support" "Bees, wasps and ants belong to the insect order Hymenoptera." "accessed" "2026-09-08"
@v712 kernel.value.record "id" "penguins-flight" "publisher" "NOAA" "title" "Can penguins fly?" "url" "https://oceanservice.noaa.gov/facts/penguinsfly.html" "support" "Penguins are birds whose wings serve swimming; they cannot fly through air." "accessed" "2026-09-08"
@v713 kernel.value.record "id" "sparrow" "publisher" "Smithsonian Institution" "title" "House Sparrow" "url" "https://qrius.si.edu/browse/object/10841863" "support" "Passer domesticus is classified within Aves. No universal claim about the flight ability of an individual sparrow is inferred." "accessed" "2026-09-08"
@v714 kernel.value.record "id" "plant-water" "publisher" "National Park Service" "title" "Desert Adaptations" "url" "https://www.nps.gov/teachers/classrooms/desert-adaptations.htm" "support" "Plants and animals need water to survive. This is a biological requirement, not an instruction to irrigate a particular plant." "accessed" "2026-09-08"
@v715 kernel.value.record "id" "weekday-order" "publisher" "timeanddate.com" "title" "The 7 Days of the Week" "url" "https://www.timeanddate.com/calendar/days/" "support" "The named seven-day cycle runs Monday through Sunday and repeats. This does not choose a local convention for the first day of the week." "accessed" "2026-09-08"
@v716 kernel.value.record "id" "month-order" "publisher" "timeanddate.com" "title" "The 12 Months of the Year" "url" "https://www.timeanddate.com/calendar/months/" "support" "The Gregorian month cycle runs January through December and repeats. No date arithmetic or leap-year rule is inferred from adjacency." "accessed" "2026-09-08"
@v717 kernel.value.record "id" "family-vocabulary" "publisher" "Cambridge University Press" "title" "Siblings and in-laws: talking about family relationships" "url" "https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/" "support" "Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile." "accessed" "2026-09-08"
@v718 kernel.value.record "id" "relation-composition" "publisher" "World Wide Web Consortium" "title" "OWL 2 Web Ontology Language Primer (Second Edition)" "url" "https://www.w3.org/TR/owl2-primer/" "support" "Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links." "accessed" "2026-09-08"
@v719 kernel.value.record "id" "temporal-order" "publisher" "World Wide Web Consortium" "title" "Time Ontology in OWL" "url" "https://www.w3.org/TR/owl-time/" "support" "Before and after express inverse temporal order. The teaching profile treats supplied events as ordered in one shared temporal frame; it does not parse dates or infer durations." "accessed" "2026-09-08"
