@v4663 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:519" "sourceId" "RO-052-09" "sourceDigest" "sha256:6e9dcceddaf1a07dd5a3ad4a438ca566f5557a8b1971f62416c3c0ddd687fccb" "sourceFile" "cases/benchmark_052.md"
@v4664 kernel.seq.make item "5" item "45" item "5 minutes" item "test"
@v4665 kernel.seq.make
@v4666 kernel.value.record "answer" "The plan can be:\n\nDay 1: one basic basic statistics concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 2: one basic basic statistics concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 3: one basic basic statistics concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 4: one basic basic statistics concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 5: review and a short test; 30 minutes for the test and correction, 10 minutes to review mistakes, and 5 minutes for conclusions.\n\nKeep notes brief. At the end of each day, record one unclear point and check it at the beginning of the next day. The goal is not to cover the whole field but to build a stable foundation in basic statistics." "requiredConcepts" $v4664 "forbiddenClaims" $v4665
@v4667 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v4668 kernel.seq.make item "core-only"
@v4669 kernel.seq.make item "assigned-train-visible" item "source-category:study-plan" item "domain:learning" item "length:medium"
@v4670 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 260 "acceptableVariations" "Daily content may vary; the number of days, time limit, review period, and final test are required."
@v4671 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0519" "source" $v4663 "pool" "source-development" "category" "study-plan" "difficulty" "medium" "scoring" "semantic" "prompt" "I want a simple study plan for basic statistics. I have 5 days, with 45 minutes per day. I am a beginner and do not want to cover too much. Each day must have one main objective, one practical activity, and five minutes of review. On the final day I want a short self-assessment test.\n\nMake a short, concrete plan of no more than 250 words." "reference" $v4666 "conversion" $v4667 "profiles" $v4668 "tags" $v4669 "constraints" $v4670 "reviewNotes" "Source policy: development-visible"
