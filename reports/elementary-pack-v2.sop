@v506 kernel.value.record "kind" "agent-authored-source-supervision" "independent" false "qualification" "Curated and formalized by a coding agent. Compilation preserves this supervision; no autonomous induction or child-level conversation is claimed." "previousSourceHash" "48e392c4937b8464b902765194c32b1611bff407a96bdd53c6f66c85feb98d23" "developmentEvidence" "The imported 88-case suite was visible before this revision. Compatibility scores are development measurements, not held-out learning evidence."
@v507 kernel.value.record "id" "vertebrates" "publisher" "National Park Service" "title" "Vertebrate Fossils" "url" "https://www.nps.gov/subjects/fossils/vertebrate-fossils.htm" "support" "Vertebrates are animals with backbones, including mammals, birds, reptiles, amphibians and fish." "accessed" "2026-09-08"
@v508 kernel.value.record "id" "dolphins" "publisher" "NOAA" "title" "Are dolphins fish?" "url" "https://oceanservice.noaa.gov/facts/dolphin.html" "support" "Dolphins are mammals and are not fish." "accessed" "2026-09-08"
@v509 kernel.value.record "id" "invertebrates" "publisher" "National Park Service" "title" "Invertebrates" "url" "https://www.nps.gov/grca/learn/nature/invertebrates.htm" "support" "Insects and spiders are invertebrates. Adult insects have six legs." "accessed" "2026-09-08"
@v510 kernel.value.record "id" "plants" "publisher" "National Park Service" "title" "Explore Plants by Form" "url" "https://www.nps.gov/dena/learn/nature/plants-by-form.htm" "support" "Trees and shrubs are plant forms; conifers are cone-producing plants." "accessed" "2026-09-08"
@v511 kernel.value.record "id" "planets" "publisher" "NASA" "title" "About the Planets" "url" "https://science.nasa.gov/solar-system/planets/" "support" "The eight named solar-system planets include four inner terrestrial planets; Pluto is a dwarf planet." "accessed" "2026-09-08"
@v512 kernel.value.record "id" "sun" "publisher" "NASA" "title" "Sun Facts" "url" "https://science.nasa.gov/sun/facts/" "support" "The Sun is the star of our solar system." "accessed" "2026-09-08"
@v513 kernel.value.record "id" "orbits" "publisher" "NASA" "title" "Our Solar System" "url" "https://science.nasa.gov/resource/our-solar-system-2/" "support" "The eight listed planets orbit the Sun; the Moon orbits Earth. The dated moon census on this page is not used." "accessed" "2026-09-08"
@v514 kernel.value.record "id" "water" "publisher" "United States Geological Survey" "title" "Water cycle" "url" "https://www.usgs.gov/water-science-school/water-cycle" "support" "Water occurs as liquid water, solid ice and gaseous water vapor." "accessed" "2026-09-08"
@v515 kernel.value.record "id" "geometry" "publisher" "Common Core State Standards Initiative" "title" "Grade 3 Geometry" "url" "https://www.thecorestandards.org/Math/Content/3/G/" "support" "Squares, rectangles and rhombuses belong to the quadrilateral category." "accessed" "2026-09-08"
@v516 kernel.value.record "id" "shapes" "publisher" "Maths Is Fun" "title" "Quadrilaterals" "url" "https://www.mathsisfun.com/quadrilaterals.html" "support" "Inclusive Euclidean plane definitions: a square is a rectangle and a rhombus; quadrilaterals are polygons." "accessed" "2026-09-08"
@v517 kernel.value.record "id" "units" "publisher" "BIPM" "title" "SI base units" "url" "https://www.bipm.org/en/measurement-units/si-base-units" "support" "The second, metre and kilogram measure time, length and mass respectively." "accessed" "2026-09-08"
@v518 kernel.value.record "id" "time" "publisher" "NIST" "title" "Units Outside the SI" "url" "https://www.nist.gov/pml/special-publication-811/nist-guide-si-chapter-5-units-outside-si" "support" "The duration units minute, hour and day equal 60 seconds, 60 minutes and 24 hours. Civil-clock anomalies are outside these duration definitions." "accessed" "2026-09-08"
@v519 kernel.value.record "id" "chair" "publisher" "Smithsonian Institution" "title" "Chair" "url" "https://americanhistory.si.edu/collections/object/nmah_317224" "support" "The collection classifies a chair as furniture. This supports the lexical category; not every chair shares this specimen material." "accessed" "2026-09-08"
@v520 kernel.value.record "id" "spoon" "publisher" "Smithsonian Institution" "title" "Synoptic Series of Objects" "url" "https://repository.si.edu/bitstream/handle/10088/15221/USNMP-60_2404_1922.pdf" "support" "A spoon is a utensil. No historical-cultural ranking in the source is used." "accessed" "2026-09-08"
@v521 kernel.value.record "id" "france" "publisher" "European Union" "title" "France: EU country" "url" "https://european-union.europa.eu/principles-countries-history/eu-countries/france_en" "support" "France is a country with Paris as its capital. No claim that all French territory is in Europe is encoded." "accessed" "2026-09-08"
@v522 kernel.value.record "id" "italy" "publisher" "European Union" "title" "Italy: EU country" "url" "https://european-union.europa.eu/principles-countries-history/eu-countries/italy_en" "support" "Italy is a country with Rome as its capital." "accessed" "2026-09-08"
@v523 kernel.value.record "id" "domestic-dog" "publisher" "Smithsonian Institution" "title" "Domestic Dog" "url" "https://qrius.si.edu/browse/object/10026879" "support" "Canis lupus familiaris is classified within Mammalia. Only taxonomic classification is used." "accessed" "2026-09-08"
@v524 kernel.value.record "id" "domestic-cat" "publisher" "Smithsonian Institution" "title" "Domestic Cat" "url" "https://qrius.si.edu/browse/object/10841947" "support" "Felis catus is classified within Mammalia. Only taxonomic classification is used." "accessed" "2026-09-08"
@v525 kernel.value.record "id" "hymenoptera" "publisher" "National Park Service" "title" "Insects and Other Arthropods" "url" "https://www.nps.gov/colm/learn/nature/insects.htm" "support" "Bees, wasps and ants belong to the insect order Hymenoptera." "accessed" "2026-09-08"
@v526 kernel.value.record "id" "penguins-flight" "publisher" "NOAA" "title" "Can penguins fly?" "url" "https://oceanservice.noaa.gov/facts/penguinsfly.html" "support" "Penguins are birds whose wings serve swimming; they cannot fly through air." "accessed" "2026-09-08"
@v527 kernel.value.record "id" "sparrow" "publisher" "Smithsonian Institution" "title" "House Sparrow" "url" "https://qrius.si.edu/browse/object/10841863" "support" "Passer domesticus is classified within Aves. No universal claim about the flight ability of an individual sparrow is inferred." "accessed" "2026-09-08"
@v528 kernel.value.record "id" "plant-water" "publisher" "National Park Service" "title" "Desert Adaptations" "url" "https://www.nps.gov/teachers/classrooms/desert-adaptations.htm" "support" "Plants and animals need water to survive. This is a biological requirement, not an instruction to irrigate a particular plant." "accessed" "2026-09-08"
@v529 kernel.value.record "id" "weekday-order" "publisher" "timeanddate.com" "title" "The 7 Days of the Week" "url" "https://www.timeanddate.com/calendar/days/" "support" "The named seven-day cycle runs Monday through Sunday and repeats. This does not choose a local convention for the first day of the week." "accessed" "2026-09-08"
@v530 kernel.value.record "id" "month-order" "publisher" "timeanddate.com" "title" "The 12 Months of the Year" "url" "https://www.timeanddate.com/calendar/months/" "support" "The Gregorian month cycle runs January through December and repeats. No date arithmetic or leap-year rule is inferred from adjacency." "accessed" "2026-09-08"
