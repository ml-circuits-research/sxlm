@v316 kernel.value.record "id" "c00cf1fbb45d03b743ee9dcc6ed0aa4bec3d0463b41c02cad79ffdab5f75334d" "text" "A pair of scissors is a tool used for cutting." "reference" $v315 "authorship" "Agent-authored paraphrase of the cited source."
