@v2108 kernel.seq.make item "Monday" item "two errors" item "figures"
@v2109 kernel.seq.make
@v2110 kernel.value.record "answer" "Hello,\n\nI noticed that the file has not been sent yet. Please finish it and send it to me by Monday. Before sending it, check the figures once more because the previous version still contained two errors.\n\nWhen the final version is ready, send me the file directly. If anything prevents you from meeting the deadline, let me know as soon as possible.\n\nThank you." "requiredConcepts" $v2108 "forbiddenClaims" $v2109
@v2111 kernel.value.record "method" "template-assisted" "reviewed" true "note" "The reference is translated faithfully even though its length may not satisfy the source’s stated 90-word minimum."
@v2112 kernel.seq.make item "core-only"
@v2113 kernel.seq.make item "assigned-train-visible" item "source-category:email-rewriting" item "domain:communication" item "length:medium"
@v2114 kernel.value.record "expectedMinWords" 56 "expectedMaxWords" 150 "acceptableVariations" "Other greetings and closings are acceptable; omitting the deadline or inventing reasons is not."
@v2115 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0235" "source" $v2107 "pool" "source-development" "category" "email-rewriting" "difficulty" "medium" "scoring" "semantic" "prompt" "Rewrite the message as a professional but not rigid email. Preserve all information and limit the answer to 90–140 words. Do not add reasons or deadlines absent from the text.\n\nRaw message: “Hello. You have not sent the file yet. I need it by Monday. Check the figures too, because the last version had two errors. Send it when it is ready.”" "reference" $v2110 "conversion" $v2111 "profiles" $v2112 "tags" $v2113 "constraints" $v2114 "reviewNotes" "Source policy: development-visible"
