@v4789 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:533" "sourceId" "RO-054-03" "sourceDigest" "sha256:363fbbcd301c02affb14e4bed595ac63ab13affa23a0aa537cfe99b942889a92" "sourceFile" "cases/benchmark_054.md"
@v4790 kernel.seq.make
@v4791 kernel.seq.make
@v4792 kernel.value.record "answer" "The essential difference is this: risk involves uncertainty about the outcome, while certainty excludes that uncertainty within the claim.\n\nA simple example should show that the terms may be related but answer different questions. They should therefore not be used as synonyms, and neither should be inferred automatically from the other without enough information.\n\n**In short:** the two concepts concern a similar subject but describe different properties or roles; a correct explanation begins by separating those roles clearly. The distinction concerns how much uncertainty remains." "requiredConcepts" $v4790 "forbiddenClaims" $v4791
@v4793 kernel.value.record "method" "manual-reviewed" "reviewed" true "note" "English wording was reviewed against the source response-length metadata."
@v4794 kernel.seq.make item "quick-assisted" item "real-kb"
@v4795 kernel.seq.make item "assigned-train-visible" item "source-category:educational-explanation" item "domain:learning" item "length:medium"
@v4796 kernel.value.record "expectedMinWords" 79 "expectedMaxWords" 190 "acceptableVariations" "The example may vary; the conceptual distinction must be correct and understandable to a student."
@v4797 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0533" "source" $v4789 "pool" "source-development" "category" "educational-explanation" "difficulty" "medium" "scoring" "semantic" "prompt" "Explain to a high-school student the difference between risk and certainty. Use no more than 180 words, one simple example, and a final “in short” sentence. Avoid unnecessary jargon." "reference" $v4792 "conversion" $v4793 "profiles" $v4794 "tags" $v4795 "constraints" $v4796 "reviewNotes" "Source policy: development-visible"
@v4798 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:534" "sourceId" "RO-054-04" "sourceDigest" "sha256:d7e49b0109ce20b2278f28326d554ffee91432d0e9b536868465dc22c4e7201f" "sourceFile" "cases/benchmark_054.md"
