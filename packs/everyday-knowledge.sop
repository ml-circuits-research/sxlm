@v283 kernel.value.record "url" "https://www.nei.nih.gov/learn-about-eye-health/healthy-vision/how-eyes-work" "title" "How the Eyes Work" "accessed" "2026-09-08"
@v284 kernel.value.record "id" "c86954ea4c3558153a4941af898b7d5e8f2a16d9ba0d49cc2f1017948ceb3bee" "text" "The human eye has a role in vision. A function of eyes is to help us see; the statement does not guarantee that every individual eye can see." "reference" $v283 "authorship" "Agent-authored paraphrase of the cited source."
@v285 kernel.value.record "source" "c86954ea4c3558153a4941af898b7d5e8f2a16d9ba0d49cc2f1017948ceb3bee" "start" 0 "end" 141
@v286 kernel.value.record "id" "eye" "singular" "eye" "plural" "eyes" "source" $v284 "evidence" $v285
@v287 kernel.value.record "url" "https://www.nidcd.nih.gov/health/how-do-we-hear" "title" "How Do We Hear?" "accessed" "2026-09-08"
@v288 kernel.value.record "id" "2bd0cf51352885a0d0b6320efba1388c569d50d54cbecc2392e40a2a8ac13b8a" "text" "The human ear participates in converting sound into signals used for hearing. Hearing is a function of ears, not a guarantee of every individual ear’s ability." "reference" $v287 "authorship" "Agent-authored paraphrase of the cited source."
@v289 kernel.value.record "source" "2bd0cf51352885a0d0b6320efba1388c569d50d54cbecc2392e40a2a8ac13b8a" "start" 0 "end" 159
@v290 kernel.value.record "id" "ear" "singular" "ear" "plural" "ears" "source" $v288 "evidence" $v289
@v291 kernel.value.record "url" "https://www.nidcd.nih.gov/news/multimedia/journey-of-smell-to-brain-text-version" "title" "The Journey of Smell to the Brain" "accessed" "2026-09-08"
@v292 kernel.value.record "id" "8bb6753d2c64ed33aff56294d70e3690706c920afbaadbbddb99b0138d0dc96c" "text" "Sensory cells in the nose detect odor molecules and contribute to smell. Smelling is a function of noses." "reference" $v291 "authorship" "Agent-authored paraphrase of the cited source."
@v293 kernel.value.record "source" "8bb6753d2c64ed33aff56294d70e3690706c920afbaadbbddb99b0138d0dc96c" "start" 0 "end" 105
@v294 kernel.value.record "id" "nose" "singular" "nose" "plural" "noses" "source" $v292 "evidence" $v293
@v295 kernel.value.record "url" "https://www.nidcd.nih.gov/health/taste-disorders" "title" "Taste Disorders: How does your sense of taste work?" "accessed" "2026-09-08"
@v296 kernel.value.record "id" "8549aca28b1c5e1914cdf220c307f9370a813096f09185a95362660672ce97e9" "text" "Taste buds on the tongue contribute to tasting. Taste receptors are not limited to the tongue, and not every person has unimpaired taste." "reference" $v295 "authorship" "Agent-authored paraphrase of the cited source."
@v297 kernel.value.record "source" "8549aca28b1c5e1914cdf220c307f9370a813096f09185a95362660672ce97e9" "start" 0 "end" 137
@v298 kernel.value.record "id" "tongue" "singular" "tongue" "plural" "tongues" "source" $v296 "evidence" $v297
@v299 kernel.value.record "url" "https://dictionary.cambridge.org/us/dictionary/english/pencil" "title" "Pencil" "accessed" "2026-09-08"
@v300 kernel.value.record "id" "557ca491f24944439955e7fac199d262055049771db184fc6b384f4cf00c9d35" "text" "Writing is one use of a pencil. This selected claim is not an exhaustive list of pencil uses." "reference" $v299 "authorship" "Agent-authored paraphrase of the cited source."
@v301 kernel.value.record "source" "557ca491f24944439955e7fac199d262055049771db184fc6b384f4cf00c9d35" "start" 0 "end" 93
@v302 kernel.value.record "id" "pencil" "singular" "pencil" "plural" "pencils" "source" $v300 "evidence" $v301
@v303 kernel.value.record "url" "https://www.collinsdictionary.com/us/dictionary/english/key" "title" "Key" "accessed" "2026-09-08"
@v304 kernel.value.record "id" "870ed3e8bfdaee50cd6df301dff29fcddc28ac9228ab776412d7791dd2c8a215" "text" "A lock key can be used to unlock its corresponding lock. This function does not imply that every key opens every lock." "reference" $v303 "authorship" "Agent-authored paraphrase of the cited source."
@v305 kernel.value.record "source" "870ed3e8bfdaee50cd6df301dff29fcddc28ac9228ab776412d7791dd2c8a215" "start" 0 "end" 118
@v306 kernel.value.record "id" "key" "singular" "key" "plural" "keys" "source" $v304 "evidence" $v305
@v307 kernel.value.record "url" "https://dictionary.cambridge.org/us/dictionary/english/umbrella" "title" "Umbrella" "accessed" "2026-09-08"
@v308 kernel.value.record "id" "6caf687ad966b9426859be988c777a61cbdf95a7a5b49298b11adb2ca273603a" "text" "An umbrella is a device used to shelter a person from rain or sun. This intended use does not guarantee dryness in every situation." "reference" $v307 "authorship" "Agent-authored paraphrase of the cited source."
@v309 kernel.value.record "source" "6caf687ad966b9426859be988c777a61cbdf95a7a5b49298b11adb2ca273603a" "start" 0 "end" 131
@v310 kernel.value.record "id" "umbrella" "singular" "umbrella" "plural" "umbrellas" "source" $v308 "evidence" $v309
@v311 kernel.value.record "url" "https://dictionary.cambridge.org/us/dictionary/english/ruler" "title" "Ruler" "accessed" "2026-09-08"
@v312 kernel.value.record "id" "6844d3c8209b4b0f36d2a44bacec98c8beda70faf2aa729776b234401ae57dc7" "text" "Measuring is one function of a ruler marked with a scale. This teaching uses the measuring-tool sense of ruler." "reference" $v311 "authorship" "Agent-authored paraphrase of the cited source."
@v313 kernel.value.record "source" "6844d3c8209b4b0f36d2a44bacec98c8beda70faf2aa729776b234401ae57dc7" "start" 0 "end" 111
@v314 kernel.value.record "id" "ruler" "singular" "ruler" "plural" "rulers" "source" $v312 "evidence" $v313
