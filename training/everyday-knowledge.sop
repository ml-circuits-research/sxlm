@v88 kernel.seq.make item "light"
@v89 kernel.value.record "url" "https://home.nps.gov/articles/000/plants-climateimpact.htm" "title" "Plants and Climate Change" "accessed" "2026-09-08"
@v90 kernel.value.record "id" "4baac425126d6ed3e8ddfc4ad9d7500a2b0dae286f080c47dd68e1aeaf2570f5" "text" "Photosynthetic plants use light, water and carbon dioxide. A light requirement is typical of plants; it is not asserted here as a universal rule for all parasitic and nonphotosynthetic plants." "reference" $v89 "authorship" "Agent-authored paraphrase of the cited source."
