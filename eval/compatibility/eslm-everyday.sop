@v1702 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:190" "sourceId" "RO-019-10" "sourceDigest" "sha256:9e82c1b44dd53da157224aa5da1a1df22b766585bd63c51f6745e77eb067724f" "sourceFile" "cases/benchmark_019.md"
@v1703 kernel.seq.make
@v1704 kernel.seq.make
@v1705 kernel.value.record "answer" "The main problem is that **lack of evidence against a claim is not sufficient evidence for it**. The premise may be relevant, but it is not sufficient for the stated general conclusion.\n\nTo make the argument stronger, add evidence that directly links the premise to the conclusion: more representative observations, relevant comparisons, tests, or information about the causal mechanism, as appropriate. State the conclusion in proportion to the strength of the evidence rather than extending it beyond that evidence." "requiredConcepts" $v1703 "forbiddenClaims" $v1704
@v1706 kernel.value.record "method" "manual-reviewed" "reviewed" true "note" ""
@v1707 kernel.seq.make item "core-only"
@v1708 kernel.seq.make item "assigned-train-visible" item "source-category:argument-critique" item "domain:logic" item "length:medium"
@v1709 kernel.value.record "expectedMinWords" 67 "expectedMaxWords" 180 "acceptableVariations" "A formal fallacy label is optional; identifying the defective logical relationship is required."
@v1710 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0190" "source" $v1702 "pool" "source-development" "category" "argument-critique" "difficulty" "medium" "scoring" "semantic" "prompt" "Analyze the argument: “No one has proved the claim false, so it is true.”\n\nIn no more than 180 words, state the main logical problem, explain why the conclusion does not follow sufficiently from the premise, and propose what additional information would make the argument stronger." "reference" $v1705 "conversion" $v1706 "profiles" $v1707 "tags" $v1708 "constraints" $v1709 "reviewNotes" "Source policy: development-visible"
