@v5978 kernel.seq.make
@v5979 kernel.seq.make
@v5980 kernel.value.record "answer" "The main problem is that **an exception does not automatically eliminate the usefulness of a general rule**. The premise may be relevant, but it is not sufficient for the stated general conclusion.\n\nTo make the argument stronger, add evidence that directly links the premise to the conclusion: more representative observations, relevant comparisons, tests, or information about the causal mechanism, as appropriate. State the conclusion in proportion to the strength of the evidence rather than extending it beyond that evidence." "requiredConcepts" $v5978 "forbiddenClaims" $v5979
@v5981 kernel.value.record "method" "manual-reviewed" "reviewed" true "note" ""
@v5982 kernel.seq.make item "core-only"
@v5983 kernel.seq.make item "assigned-train-visible" item "source-category:argument-critique" item "domain:logic" item "length:medium"
@v5984 kernel.value.record "expectedMinWords" 69 "expectedMaxWords" 180 "acceptableVariations" "A formal fallacy label is optional; identifying the defective logical relationship is required."
@v5985 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0665" "source" $v5977 "pool" "source-development" "category" "argument-critique" "difficulty" "medium" "scoring" "semantic" "prompt" "Analyze the argument: “If a rule has one exception, the rule is not useful at all.”\n\nIn no more than 180 words, state the main logical problem, explain why the conclusion does not follow sufficiently from the premise, and propose what additional information would make the argument stronger." "reference" $v5980 "conversion" $v5981 "profiles" $v5982 "tags" $v5983 "constraints" $v5984 "reviewNotes" "Source policy: development-visible"
@v5986 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:666" "sourceId" "RO-067-06" "sourceDigest" "sha256:fb983472b7066fddfea585f7652f3160908f0b62e446fda0a42911e1f3446431" "sourceFile" "cases/benchmark_067.md"
