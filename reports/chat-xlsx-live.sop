@v2517 kernel.value.record "id" "e5a059bd15980fc7a008f9f7a9fe18356b3abfdcc89bec75eee6c5f0d3bcb92c" "text" "@v0 kernel.seq.make item \"?x\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"fern\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"fern\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"kind\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"plants\" \"publisher\" \"National Park Service\" \"support\" \"Trees and shrubs are plant forms; conifers are cone-producing plants.\" \"title\" \"Explore Plants by Form\" \"url\" \"https://www.nps.gov/dena/learn/nature/plants-by-form.htm\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"classification.fern\" \"statement\" \"An instance of fern can be described by that category.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2518 kernel.value.record "id" "65206296454f997311a52be2dec3d61db725ca9d366a5808fdb51e225a4e29e9" "text" "@v0 kernel.seq.make item \"?x\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"penguin\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" true \"predicate\" \"can_fly\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"penguins-flight\" \"publisher\" \"NOAA\" \"support\" \"Penguins are birds whose wings serve swimming; they cannot fly through air.\" \"title\" \"Can penguins fly?\" \"url\" \"https://oceanservice.noaa.gov/facts/penguinsfly.html\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"penguin.not-fly\" \"statement\" \"Penguins cannot fly through air.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2519 kernel.value.record "id" "37a1bdc9b260465a99d3d6ec8744fe452366d5983823d13f6d7f7df8031529c7" "text" "@v0 kernel.seq.make item \"?x\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"plant\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"water\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"need\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"plant-water\" \"publisher\" \"National Park Service\" \"support\" \"Plants and animals need water to survive. This is a biological requirement, not an instruction to irrigate a particular plant.\" \"title\" \"Desert Adaptations\" \"url\" \"https://www.nps.gov/teachers/classrooms/desert-adaptations.htm\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"plant.needs-water\" \"statement\" \"Plants need water to survive.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2520 kernel.value.record "id" "2a9b06e20e12ebb7f58b3b7dd46a74790a68d76f34415449bbbb91d733de229a" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"next_in_cycle\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"previous_in_cycle\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"weekday-order\" \"publisher\" \"timeanddate.com\" \"support\" \"The named seven-day cycle runs Monday through Sunday and repeats. This does not choose a local convention for the first day of the week.\" \"title\" \"The 7 Days of the Week\" \"url\" \"https://www.timeanddate.com/calendar/days/\"\n@v6 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"month-order\" \"publisher\" \"timeanddate.com\" \"support\" \"The Gregorian month cycle runs January through December and repeats. No date arithmetic or leap-year rule is inferred from adjacency.\" \"title\" \"The 12 Months of the Year\" \"url\" \"https://www.timeanddate.com/calendar/months/\"\n@v7 kernel.seq.make item $v5 item $v6\n@v8 kernel.value.record \"citations\" $v7 \"id\" \"calendar.previous\" \"statement\" \"Predecessor is the inverse of successor in a named cycle.\"\n@v9 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v8\n@output result $v9\n" "pack" "elementary-knowledge"
@v2521 kernel.value.record "id" "78f6e4d54566f3a2eed5bec048047b804a4765f276a7dedad33c943ebeca0d5b" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"mother_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"?y\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"parent_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"family-vocabulary\" \"publisher\" \"Cambridge University Press\" \"support\" \"Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile.\" \"title\" \"Siblings and in-laws: talking about family relationships\" \"url\" \"https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.specialization.mother_of\" \"statement\" \"The ordinary mother_of relation is a specialization of parent_of.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2522 kernel.value.record "id" "7d8243180fd59aadc8267731bad6f252a75cb4f03fe8863606323cca42d96418" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"father_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"?y\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"parent_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"family-vocabulary\" \"publisher\" \"Cambridge University Press\" \"support\" \"Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile.\" \"title\" \"Siblings and in-laws: talking about family relationships\" \"url\" \"https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.specialization.father_of\" \"statement\" \"The ordinary father_of relation is a specialization of parent_of.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2523 kernel.value.record "id" "fed7e14379139598037e1783ac4112f5047233dd1b3054b13da3b077dc5c8cd9" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"brother_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"?y\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"sibling_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"family-vocabulary\" \"publisher\" \"Cambridge University Press\" \"support\" \"Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile.\" \"title\" \"Siblings and in-laws: talking about family relationships\" \"url\" \"https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.specialization.brother_of\" \"statement\" \"The ordinary brother_of relation is a specialization of sibling_of.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2524 kernel.value.record "id" "3da017128147955305c97bc539744ffc7af7d86056331cd4ad655d434f14476e" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"sister_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"?y\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"sibling_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"family-vocabulary\" \"publisher\" \"Cambridge University Press\" \"support\" \"Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile.\" \"title\" \"Siblings and in-laws: talking about family relationships\" \"url\" \"https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.specialization.sister_of\" \"statement\" \"The ordinary sister_of relation is a specialization of sibling_of.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2525 kernel.value.record "id" "f1f4c30618e0c7ae25c789039143ef056bee3546692f041cf57a2bb68ff64f97" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"sibling_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"sibling_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"family-vocabulary\" \"publisher\" \"Cambridge University Press\" \"support\" \"Parent includes mother and father; sibling includes brother and sister. These statements define the ordinary kinship senses used in this teaching profile.\" \"title\" \"Siblings and in-laws: talking about family relationships\" \"url\" \"https://dictionaryblog.cambridge.org/2021/12/22/siblings-and-in-laws-talking-about-family-relationships/\"\n@v6 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v7 kernel.seq.make item $v5 item $v6\n@v8 kernel.value.record \"citations\" $v7 \"id\" \"relations.sibling.symmetric\" \"statement\" \"Sibling is a symmetric kinship relation; this does not infer siblings from shared parenthood.\"\n@v9 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v8\n@output result $v9\n" "pack" "elementary-knowledge"
@v2526 kernel.value.record "id" "44ae80482ba9b530df447d6b509e0a2f8ca206f8a7ffa799b2fe831c7a2df567" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"parent_of\" \"terms\" $v0\n@v2 kernel.seq.make item \"?y\" item \"?z\"\n@v3 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"parent_of\" \"terms\" $v2\n@v4 kernel.seq.make item $v1 item $v3\n@v5 kernel.seq.make item \"?x\" item \"?z\"\n@v6 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandparent_of\" \"terms\" $v5\n@v7 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v8 kernel.seq.make item $v7\n@v9 kernel.value.record \"citations\" $v8 \"id\" \"relations.grandparent.chain\" \"statement\" \"A parent of a parent is a grandparent. This rule composes known links and does not invent unknown parents.\"\n@v10 kernel.value.record \"body\" $v4 \"head\" $v6 \"teaching\" $v9\n@output result $v10\n" "pack" "elementary-knowledge"
@v2527 kernel.value.record "id" "ca3a1e7f5526ba6813332793efda60e1746f5dffb6d94771cd7eef09471e8863" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandparent_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?x\" item \"?y\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"ancestor_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.grandparent.ancestor\" \"statement\" \"A grandparent is an ancestor; direct parent links need not be known.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2528 kernel.value.record "id" "4248f38df051e3b0b29381ffc85d4d1b6a1e4ce80d99a69eeafb9b50edbb730c" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandparent_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandchild_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.inverse.grandparent_of\" \"statement\" \"grandparent_of and grandchild_of name opposite directions of the same kinship relation.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2529 kernel.value.record "id" "4696016e1bccc2a1b96ef0171788d17dc985a4c786fead1190be657f29387349" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandchild_of\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"grandparent_of\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v6 kernel.seq.make item $v5\n@v7 kernel.value.record \"citations\" $v6 \"id\" \"relations.inverse.grandchild_of\" \"statement\" \"grandchild_of and grandparent_of name opposite directions of the same kinship relation.\"\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v7\n@output result $v8\n" "pack" "elementary-knowledge"
@v2530 kernel.value.record "id" "ec5abf63e05d0d582ce12ccf2b1b04c961ea655f7fc4d8e44d23fc906bc47d0b" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"before\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"after\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"temporal-order\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Before and after express inverse temporal order. The teaching profile treats supplied events as ordered in one shared temporal frame; it does not parse dates or infer durations.\" \"title\" \"Time Ontology in OWL\" \"url\" \"https://www.w3.org/TR/owl-time/\"\n@v6 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v7 kernel.seq.make item $v5 item $v6\n@v8 kernel.value.record \"citations\" $v7 \"id\" \"relations.inverse.before\" \"statement\" \"In the declared profile with one shared temporal frame, before(x,y) implies after(y,x).\"\n@v9 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v8\n@output result $v9\n" "pack" "elementary-knowledge"
@v2531 kernel.value.record "id" "371524978093fce4ef5031c9f986053c0e849c7e5eef0025062a534959de26fe" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"before\" \"terms\" $v0\n@v2 kernel.seq.make item \"?y\" item \"?z\"\n@v3 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"before\" \"terms\" $v2\n@v4 kernel.seq.make item $v1 item $v3\n@v5 kernel.seq.make item \"?x\" item \"?z\"\n@v6 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"before\" \"terms\" $v5\n@v7 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"temporal-order\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Before and after express inverse temporal order. The teaching profile treats supplied events as ordered in one shared temporal frame; it does not parse dates or infer durations.\" \"title\" \"Time Ontology in OWL\" \"url\" \"https://www.w3.org/TR/owl-time/\"\n@v8 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v9 kernel.seq.make item $v7 item $v8\n@v10 kernel.value.record \"citations\" $v9 \"id\" \"relations.transitive.before\" \"statement\" \"In the declared profile with one shared temporal frame, before is a transitive strict ordering.\"\n@v11 kernel.value.record \"body\" $v4 \"head\" $v6 \"teaching\" $v10\n@output result $v11\n" "pack" "elementary-knowledge"
@v2532 kernel.value.record "id" "987ddf1929ebee82202fb9930d08ae3009fa0afe87202954ea88f70de66688ea" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"before\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?y\" item \"?x\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" true \"predicate\" \"before\" \"terms\" $v3\n@v5 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"temporal-order\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Before and after express inverse temporal order. The teaching profile treats supplied events as ordered in one shared temporal frame; it does not parse dates or infer durations.\" \"title\" \"Time Ontology in OWL\" \"url\" \"https://www.w3.org/TR/owl-time/\"\n@v6 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v7 kernel.seq.make item $v5 item $v6\n@v8 kernel.value.record \"citations\" $v7 \"id\" \"relations.asymmetric.before\" \"statement\" \"In the declared profile with one shared temporal frame, before(x,y) excludes before(y,x). Contradictory supplied orders remain contradictory.\"\n@v9 kernel.value.record \"body\" $v2 \"head\" $v4 \"teaching\" $v8\n@output result $v9\n" "pack" "elementary-knowledge"
