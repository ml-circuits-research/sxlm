@v2581 kernel.seq.make item "assigned-train-visible" item "source-category:educational-explanation" item "domain:learning" item "length:medium"
@v2582 kernel.value.record "expectedMinWords" 78 "expectedMaxWords" 190 "acceptableVariations" "The example may vary; the conceptual distinction must be correct and understandable to a student."
