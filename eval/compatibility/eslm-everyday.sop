@v2216 kernel.seq.make item "Wednesday" item "two errors" item "figures"
@v2217 kernel.seq.make
@v2218 kernel.value.record "answer" "Hello,\n\nI noticed that the file has not been sent yet. Please finish it and send it to me by Wednesday. Before sending it, check the figures once more because the previous version still contained two errors.\n\nWhen the final version is ready, send me the file directly. If anything prevents you from meeting the deadline, let me know as soon as possible.\n\nThank you." "requiredConcepts" $v2216 "forbiddenClaims" $v2217
@v2219 kernel.value.record "method" "template-assisted" "reviewed" true "note" "The reference is translated faithfully even though its length may not satisfy the source’s stated 90-word minimum."
@v2220 kernel.seq.make item "core-only"
@v2221 kernel.seq.make item "assigned-train-visible" item "source-category:email-rewriting" item "domain:communication" item "length:medium"
@v2222 kernel.value.record "expectedMinWords" 56 "expectedMaxWords" 150 "acceptableVariations" "Other greetings and closings are acceptable; omitting the deadline or inventing reasons is not."
