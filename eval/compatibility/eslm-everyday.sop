@v1854 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0206" "source" $v1846 "pool" "source-development" "category" "applied-calculation" "difficulty" "easy" "scoring" "exact" "prompt" "How many hours are in 300 minutes? Use only the information in the request." "reference" $v1849 "conversion" $v1850 "profiles" $v1851 "tags" $v1852 "constraints" $v1853 "reviewNotes" "Source policy: development-visible"
@v1855 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:207" "sourceId" "RO-021-07" "sourceDigest" "sha256:c5ead117a4f7bc73768d5e9af29d6a2e1d1d94126d5a5afc5f82c1c9b3d89f83" "sourceFile" "cases/benchmark_021.md"
@v1856 kernel.seq.make item "notifications" item "interface" item "search" item "favorites"
@v1857 kernel.seq.make
@v1858 kernel.value.record "answer" "I would group the feedback into four themes:\n\n1. **Speed and setup:** quick opening and easy initial setup are positive points.\n2. **Interface and accessibility:** the interface is praised as simple, but there is a request for larger text.\n3. **Search and organization:** favorites are appreciated, but old documents are difficult to find.\n4. **Notifications:** notifications are sometimes missing and sometimes duplicated.\n\nThe clear positive aspects are simplicity, speed, setup, and favorites. The recurring problem is notification reliability because two different comments report incorrect behavior in that area.\n\nThis sample does not establish how frequent the problems are across the entire user base." "requiredConcepts" $v1856 "forbiddenClaims" $v1857
@v1859 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v1860 kernel.seq.make item "core-only"
@v1861 kernel.seq.make item "assigned-train-visible" item "source-category:feedback-synthesis" item "domain:text-analysis" item "length:medium"
@v1862 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 230 "acceptableVariations" "The grouping may use three or four themes, but it must recognize both notification-related problems."
@v1863 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0207" "source" $v1855 "pool" "source-development" "category" "feedback-synthesis" "difficulty" "medium" "scoring" "semantic" "prompt" "You have the following eight comments about a fictional application:\n1. “It opens quickly.”\n2. “Sometimes I do not receive notifications.”\n3. “The interface is simple.”\n4. “Search has difficulty finding old documents.”\n5. “I like being able to save favorites.”\n6. “I would like larger text.”\n7. “I received two notifications for the same event.”\n8. “Initial setup was easy.”\n\nGroup the feedback into no more than four themes, state what is positive and which problem recurs. Do not invent frequencies beyond the eight comments. Maximum 220 words. Preserve the request’s exact meaning." "reference" $v1858 "conversion" $v1859 "profiles" $v1860 "tags" $v1861 "constraints" $v1862 "reviewNotes" "Source policy: development-visible"
@v1864 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:208" "sourceId" "RO-021-08" "sourceDigest" "sha256:a251f4f907966ec3299b70f233f5491b1f6fed2f84fdb190831ffd70b28cb8dc" "sourceFile" "cases/benchmark_021.md"
