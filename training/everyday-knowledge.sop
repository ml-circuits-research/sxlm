@v0 kernel.value.record "url" "https://www.nei.nih.gov/learn-about-eye-health/healthy-vision/how-eyes-work" "title" "How the Eyes Work" "accessed" "2026-09-08"
@v1 kernel.value.record "id" "c86954ea4c3558153a4941af898b7d5e8f2a16d9ba0d49cc2f1017948ceb3bee" "text" "The human eye has a role in vision. A function of eyes is to help us see; the statement does not guarantee that every individual eye can see." "reference" $v0 "authorship" "Agent-authored paraphrase of the cited source."
@v2 kernel.value.record "source" "c86954ea4c3558153a4941af898b7d5e8f2a16d9ba0d49cc2f1017948ceb3bee" "start" 0 "end" 141
@v3 kernel.value.record "id" "eye" "singular" "eye" "plural" "eyes" "source" $v1 "evidence" $v2
@v4 kernel.value.record "url" "https://www.nidcd.nih.gov/health/how-do-we-hear" "title" "How Do We Hear?" "accessed" "2026-09-08"
@v5 kernel.value.record "id" "2bd0cf51352885a0d0b6320efba1388c569d50d54cbecc2392e40a2a8ac13b8a" "text" "The human ear participates in converting sound into signals used for hearing. Hearing is a function of ears, not a guarantee of every individual ear’s ability." "reference" $v4 "authorship" "Agent-authored paraphrase of the cited source."
@v6 kernel.value.record "source" "2bd0cf51352885a0d0b6320efba1388c569d50d54cbecc2392e40a2a8ac13b8a" "start" 0 "end" 159
@v7 kernel.value.record "id" "ear" "singular" "ear" "plural" "ears" "source" $v5 "evidence" $v6
@v8 kernel.value.record "url" "https://www.nidcd.nih.gov/news/multimedia/journey-of-smell-to-brain-text-version" "title" "The Journey of Smell to the Brain" "accessed" "2026-09-08"
@v9 kernel.value.record "id" "8bb6753d2c64ed33aff56294d70e3690706c920afbaadbbddb99b0138d0dc96c" "text" "Sensory cells in the nose detect odor molecules and contribute to smell. Smelling is a function of noses." "reference" $v8 "authorship" "Agent-authored paraphrase of the cited source."
@v10 kernel.value.record "source" "8bb6753d2c64ed33aff56294d70e3690706c920afbaadbbddb99b0138d0dc96c" "start" 0 "end" 105
@v11 kernel.value.record "id" "nose" "singular" "nose" "plural" "noses" "source" $v9 "evidence" $v10
@v12 kernel.value.record "url" "https://www.nidcd.nih.gov/health/taste-disorders" "title" "Taste Disorders: How does your sense of taste work?" "accessed" "2026-09-08"
@v13 kernel.value.record "id" "8549aca28b1c5e1914cdf220c307f9370a813096f09185a95362660672ce97e9" "text" "Taste buds on the tongue contribute to tasting. Taste receptors are not limited to the tongue, and not every person has unimpaired taste." "reference" $v12 "authorship" "Agent-authored paraphrase of the cited source."
@v14 kernel.value.record "source" "8549aca28b1c5e1914cdf220c307f9370a813096f09185a95362660672ce97e9" "start" 0 "end" 137
