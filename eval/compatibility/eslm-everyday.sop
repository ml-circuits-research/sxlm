@v2575 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:287" "sourceId" "RO-029-07" "sourceDigest" "sha256:13aed926c5a4965b482116821ed04cf11f1ecdcf8cc4820e00301756e95841fe" "sourceFile" "cases/benchmark_029.md"
@v2576 kernel.seq.make
@v2577 kernel.seq.make
@v2578 kernel.value.record "answer" "The essential difference is this: mass is a property of an object, while weight is the gravitational force exerted on it.\n\nA simple example should show that the terms may be related but answer different questions. They should therefore not be used as synonyms, and neither should be inferred automatically from the other without enough information.\n\n**In short:** the two concepts concern a similar subject but describe different properties or roles; a correct explanation begins by separating those roles clearly." "requiredConcepts" $v2576 "forbiddenClaims" $v2577
@v2579 kernel.value.record "method" "manual-reviewed" "reviewed" true "note" ""
