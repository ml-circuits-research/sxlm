@v647 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 260 "acceptableVariations" "Daily content may vary; the number of days, time limit, review period, and final test are required."
@v648 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0072" "source" $v640 "pool" "source-development" "category" "study-plan" "difficulty" "medium" "scoring" "semantic" "prompt" "I want a simple study plan for European history. I have 6 days, with 45 minutes per day. I am a beginner and do not want to cover too much. Each day must have one main objective, one practical activity, and five minutes of review. On the final day I want a short self-assessment test.\n\nMake a short, concrete plan of no more than 250 words." "reference" $v643 "conversion" $v644 "profiles" $v645 "tags" $v646 "constraints" $v647 "reviewNotes" "Source policy: development-visible"
@v649 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:73" "sourceId" "RO-008-03" "sourceDigest" "sha256:30d525e06b9fab79e78733222b0203e097cf0bf246aa450fb2983ffa011b1bec" "sourceFile" "cases/benchmark_008.md"
