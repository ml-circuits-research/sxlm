@v378 kernel.value.record "id" "vertebrates" "publisher" "National Park Service" "title" "Vertebrate Fossils" "url" "https://www.nps.gov/subjects/fossils/vertebrate-fossils.htm" "support" "Vertebrates are animals with backbones, including mammals, birds, reptiles, amphibians and fish." "accessed" "2026-09-08"
@v379 kernel.value.record "id" "dolphins" "publisher" "NOAA" "title" "Are dolphins fish?" "url" "https://oceanservice.noaa.gov/facts/dolphin.html" "support" "Dolphins are mammals and are not fish." "accessed" "2026-09-08"
@v380 kernel.value.record "id" "invertebrates" "publisher" "National Park Service" "title" "Invertebrates" "url" "https://www.nps.gov/grca/learn/nature/invertebrates.htm" "support" "Insects and spiders are invertebrates. Adult insects have six legs." "accessed" "2026-09-08"
@v381 kernel.value.record "id" "plants" "publisher" "National Park Service" "title" "Explore Plants by Form" "url" "https://www.nps.gov/dena/learn/nature/plants-by-form.htm" "support" "Trees and shrubs are plant forms; conifers are cone-producing plants." "accessed" "2026-09-08"
@v382 kernel.value.record "id" "planets" "publisher" "NASA" "title" "About the Planets" "url" "https://science.nasa.gov/solar-system/planets/" "support" "The eight named solar-system planets include four inner terrestrial planets; Pluto is a dwarf planet." "accessed" "2026-09-08"
@v383 kernel.value.record "id" "sun" "publisher" "NASA" "title" "Sun Facts" "url" "https://science.nasa.gov/sun/facts/" "support" "The Sun is the star of our solar system." "accessed" "2026-09-08"
@v384 kernel.value.record "id" "orbits" "publisher" "NASA" "title" "Our Solar System" "url" "https://science.nasa.gov/resource/our-solar-system-2/" "support" "The eight listed planets orbit the Sun; the Moon orbits Earth. The dated moon census on this page is not used." "accessed" "2026-09-08"
@v385 kernel.value.record "id" "water" "publisher" "United States Geological Survey" "title" "Water cycle" "url" "https://www.usgs.gov/water-science-school/water-cycle" "support" "Water occurs as liquid water, solid ice and gaseous water vapor." "accessed" "2026-09-08"
@v386 kernel.value.record "id" "geometry" "publisher" "Common Core State Standards Initiative" "title" "Grade 3 Geometry" "url" "https://www.thecorestandards.org/Math/Content/3/G/" "support" "Squares, rectangles and rhombuses belong to the quadrilateral category." "accessed" "2026-09-08"
@v387 kernel.value.record "id" "shapes" "publisher" "Maths Is Fun" "title" "Quadrilaterals" "url" "https://www.mathsisfun.com/quadrilaterals.html" "support" "Inclusive Euclidean plane definitions: a square is a rectangle and a rhombus; quadrilaterals are polygons." "accessed" "2026-09-08"
@v388 kernel.value.record "id" "units" "publisher" "BIPM" "title" "SI base units" "url" "https://www.bipm.org/en/measurement-units/si-base-units" "support" "The second, metre and kilogram measure time, length and mass respectively." "accessed" "2026-09-08"
@v389 kernel.value.record "id" "time" "publisher" "NIST" "title" "Units Outside the SI" "url" "https://www.nist.gov/pml/special-publication-811/nist-guide-si-chapter-5-units-outside-si" "support" "The duration units minute, hour and day equal 60 seconds, 60 minutes and 24 hours. Civil-clock anomalies are outside these duration definitions." "accessed" "2026-09-08"
@v390 kernel.value.record "id" "chair" "publisher" "Smithsonian Institution" "title" "Chair" "url" "https://americanhistory.si.edu/collections/object/nmah_317224" "support" "The collection classifies a chair as furniture. This supports the lexical category; not every chair shares this specimen material." "accessed" "2026-09-08"
@v391 kernel.value.record "id" "spoon" "publisher" "Smithsonian Institution" "title" "Synoptic Series of Objects" "url" "https://repository.si.edu/bitstream/handle/10088/15221/USNMP-60_2404_1922.pdf" "support" "A spoon is a utensil. No historical-cultural ranking in the source is used." "accessed" "2026-09-08"
@v392 kernel.value.record "id" "france" "publisher" "European Union" "title" "France: EU country" "url" "https://european-union.europa.eu/principles-countries-history/eu-countries/france_en" "support" "France is a country with Paris as its capital. No claim that all French territory is in Europe is encoded." "accessed" "2026-09-08"
