@v639 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0071" "source" $v631 "pool" "source-development" "category" "short-problem" "difficulty" "easy" "scoring" "exact" "prompt" "There are 8 people at a table, and each receives 5 glasses of water. How many glasses are needed? Answer directly and do not add unrequested information." "reference" $v634 "conversion" $v635 "profiles" $v636 "tags" $v637 "constraints" $v638 "reviewNotes" "Source policy: development-visible"
