@v2251 kernel.value.record "id" "2ad7d446692e4f8348b282075021f07e78fc6ba5104254e39e9cb08759a8b1a0" "text" "@v0 kernel.seq.make item \"?x\" item \"?y\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"in\" \"terms\" $v0\n@v2 kernel.seq.make item \"?y\" item \"?z\"\n@v3 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"in\" \"terms\" $v2\n@v4 kernel.seq.make item $v1 item $v3\n@v5 kernel.seq.make item \"?x\" item \"?z\"\n@v6 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"in\" \"terms\" $v5\n@v7 kernel.value.record \"accessed\" \"2026-09-08\" \"id\" \"relation-composition\" \"publisher\" \"World Wide Web Consortium\" \"support\" \"Property inclusions, inverses, symmetry, transitivity and parent chains illustrate explicit relational axioms. The SXLM profile uses signed Horn rules, not an OWL implementation. A grandparent relation composes two parent links.\" \"title\" \"OWL 2 Web Ontology Language Primer (Second Edition)\" \"url\" \"https://www.w3.org/TR/owl2-primer/\"\n@v8 kernel.seq.make item $v7\n@v9 kernel.value.record \"citations\" $v8 \"id\" \"relations.containment.transitive\" \"statement\" \"In this profile, in denotes literal spatial containment within one state, and containment is transitive. Metaphorical membership and movement updates are outside this axiom.\"\n@v10 kernel.value.record \"body\" $v4 \"head\" $v6 \"teaching\" $v9\n@output result $v10\n" "pack" "elementary-knowledge"
@v2252 kernel.value.record "id" "150cd21195a121ecff3a5c09b654151b7852e9d51ce6822dc0747065adee22a6" "text" "@v0 kernel.seq.make item \"?person\"\n@v1 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"pilot\" \"terms\" $v0\n@v2 kernel.seq.make item $v1\n@v3 kernel.seq.make item \"?person\"\n@v4 kernel.value.record \"context\" \"world\" \"negative\" false \"predicate\" \"careful\" \"terms\" $v3\n@v5 kernel.value.record \"end\" 257 \"source\" \"5b49762cf7d7b5c5b8f3651c38f91b774e8f69ffc33ffa1ef0fd353c68f928d4\" \"start\" 234\n@v6 kernel.value.record \"documentHash\" \"8f92f807e4f0593ae74625ec1965b5e6cf906bad6c1d49cce0da82bac7fbf4ea\" \"endChunk\" 0 \"extractionHash\" \"5b49762cf7d7b5c5b8f3651c38f91b774e8f69ffc33ffa1ef0fd353c68f928d4\" \"id\" \"5b49762cf7d7b5c5b8f3651c38f91b774e8f69ffc33ffa1ef0fd353c68f928d4\" \"pack\" \"Crew.xlsx\" \"startChunk\" 0 \"text\" \"[Worksheet: Crew; part: xl/worksheets/sheet1.xml; visible]\\nA1\\tName\\nB1\\tRole\\nC1\\tLocation\\nA2\\tHarper\\nB2\\tpilot\\nC2\\tNorth station\\nA3\\tEllis\\nB3\\tmedic\\nC3\\tSouth station\\n[Worksheet: Rules; part: xl/worksheets/sheet2.xml; visible]\\nA1\\tStatement\\nA2\\tEvery pilot is careful.\\nA3\\tNo medic is a pilot.\\nA4\\tEach Location cell gives the place where that person is.\\n\"\n@v7 kernel.value.record \"evidence\" $v5 \"source\" $v6\n@v8 kernel.value.record \"body\" $v2 \"head\" $v4 \"id\" \"document.a122ff16fccc4615902c8a19f155780a.pilot-careful\" \"teaching\" $v7\n@output result $v8\n" "pack" "Crew.xlsx"
