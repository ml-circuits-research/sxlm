@input with object
@symbol kernel.value.get value $with key "symbol" fallback null
@category kernel.value.get value $symbol key "lex" fallback null
@token kernel.value.get value $with key "token" fallback null
@value kernel.value.get value $token key "value" fallback null
@parts kernel.seq.make item $category item $value
@key kernel.value.encode value $parts
@knowledge kernel.value.get value $with key "knowledge" fallback null
@index kernel.value.get value $knowledge key "lexicon" fallback null
@empty kernel.seq.empty
@values kernel.value.get value $index key $key fallback $empty
@out data.array value $values
@output result $out
