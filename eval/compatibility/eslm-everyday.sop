@v755 kernel.value.record "expectedMinWords" 95 "expectedMaxWords" 230 "acceptableVariations" "The menu may vary; the time constraint and prohibition on invented prices must be preserved."
@v756 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0084" "source" $v748 "pool" "source-development" "category" "practical-plan" "difficulty" "medium" "scoring" "semantic" "prompt" "I want to organize a small gathering at home for eight people. The maximum budget is 1050 lei. I do not want a sophisticated menu. I have two hours to prepare, and during the final half hour I want to stop cooking and only set the table and get ready.\n\nPropose a practical plan in stages. Do not give exact product prices because I did not provide local prices. Maximum 220 words." "reference" $v751 "conversion" $v752 "profiles" $v753 "tags" $v754 "constraints" $v755 "reviewNotes" "Source policy: development-visible"
@v757 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:85" "sourceId" "RO-009-05" "sourceDigest" "sha256:c300ef95b1f6cd2f96a9308e8ef55e1aaa0615f0afdc4425d7873c8aab95094b" "sourceFile" "cases/benchmark_009.md"
