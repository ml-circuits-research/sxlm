@v344 kernel.seq.make item "5" item "45" item "5 minutes" item "test"
@v345 kernel.seq.make
@v346 kernel.value.record "answer" "The plan can be:\n\nDay 1: one basic logic concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 2: one basic logic concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 3: one basic logic concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 4: one basic logic concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 5: review and a short test; 30 minutes for the test and correction, 10 minutes to review mistakes, and 5 minutes for conclusions.\n\nKeep notes brief. At the end of each day, record one unclear point and check it at the beginning of the next day. The goal is not to cover the whole field but to build a stable foundation in logic." "requiredConcepts" $v344 "forbiddenClaims" $v345
@v347 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v348 kernel.seq.make item "core-only"
@v349 kernel.seq.make item "assigned-train-visible" item "source-category:study-plan" item "domain:learning" item "length:medium"
@v350 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 260 "acceptableVariations" "Daily content may vary; the number of days, time limit, review period, and final test are required."
@v351 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0039" "source" $v343 "pool" "source-development" "category" "study-plan" "difficulty" "medium" "scoring" "semantic" "prompt" "I want a simple study plan for logic. I have 5 days, with 45 minutes per day. I am a beginner and do not want to cover too much. Each day must have one main objective, one practical activity, and five minutes of review. On the final day I want a short self-assessment test.\n\nMake a short, concrete plan of no more than 250 words." "reference" $v346 "conversion" $v347 "profiles" $v348 "tags" $v349 "constraints" $v350 "reviewNotes" "Source policy: development-visible"
@v352 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:40" "sourceId" "RO-004-10" "sourceDigest" "sha256:842319eab4c214fce5891f388593327e6fa5f17e177b47c93a1f688bdaa9620d" "sourceFile" "cases/benchmark_004.md"
