@v3907 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:435" "sourceId" "RO-044-05" "sourceDigest" "sha256:22637000275ea8141e5af029924b3c94cc613376bd2d8faaa58100bd6ed3e00d" "sourceFile" "cases/benchmark_044.md"
@v3908 kernel.seq.make item "7" item "45" item "5 minutes" item "test"
@v3909 kernel.seq.make
@v3910 kernel.value.record "answer" "The plan can be:\n\nDay 1: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 2: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 3: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 4: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 5: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 6: one basic cell biology concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 7: review and a short test; 30 minutes for the test and correction, 10 minutes to review mistakes, and 5 minutes for conclusions.\n\nKeep notes brief. At the end of each day, record one unclear point and check it at the beginning of the next day. The goal is not to cover the whole field but to build a stable foundation in cell biology." "requiredConcepts" $v3908 "forbiddenClaims" $v3909
@v3911 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v3912 kernel.seq.make item "core-only"
