@v586 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:66" "sourceId" "RO-007-06" "sourceDigest" "sha256:3293145a1b8dd72d208d38c2d928210d0bd793b136629cdff719d5890f90bcbf" "sourceFile" "cases/benchmark_007.md"
@v587 kernel.seq.make item "7" item "45" item "5 minutes" item "test"
@v588 kernel.seq.make
@v589 kernel.value.record "answer" "The plan can be:\n\nDay 1: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 2: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 3: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 4: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 5: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 6: one basic astronomy concept; 25 minutes of study, 15 minutes of practical exercise, and 5 minutes of review.\nDay 7: review and a short test; 30 minutes for the test and correction, 10 minutes to review mistakes, and 5 minutes for conclusions.\n\nKeep notes brief. At the end of each day, record one unclear point and check it at the beginning of the next day. The goal is not to cover the whole field but to build a stable foundation in astronomy." "requiredConcepts" $v587 "forbiddenClaims" $v588
@v590 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v591 kernel.seq.make item "core-only"
@v592 kernel.seq.make item "assigned-train-visible" item "source-category:study-plan" item "domain:learning" item "length:medium"
@v593 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 260 "acceptableVariations" "Daily content may vary; the number of days, time limit, review period, and final test are required."
@v594 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0066" "source" $v586 "pool" "source-development" "category" "study-plan" "difficulty" "medium" "scoring" "semantic" "prompt" "I want a simple study plan for astronomy. I have 7 days, with 45 minutes per day. I am a beginner and do not want to cover too much. Each day must have one main objective, one practical activity, and five minutes of review. On the final day I want a short self-assessment test.\n\nMake a short, concrete plan of no more than 250 words." "reference" $v589 "conversion" $v590 "profiles" $v591 "tags" $v592 "constraints" $v593 "reviewNotes" "Source policy: development-visible"
