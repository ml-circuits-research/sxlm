@v18 kernel.value.record "id" "domestic-cat" "publisher" "Smithsonian Institution" "title" "Domestic Cat" "url" "https://qrius.si.edu/browse/object/10841947" "support" "Felis catus is classified within Mammalia. Only taxonomic classification is used." "accessed" "2026-09-08"
@v19 kernel.value.record "id" "hymenoptera" "publisher" "National Park Service" "title" "Insects and Other Arthropods" "url" "https://www.nps.gov/colm/learn/nature/insects.htm" "support" "Bees, wasps and ants belong to the insect order Hymenoptera." "accessed" "2026-09-08"
@v20 kernel.value.record "id" "penguins-flight" "publisher" "NOAA" "title" "Can penguins fly?" "url" "https://oceanservice.noaa.gov/facts/penguinsfly.html" "support" "Penguins are birds whose wings serve swimming; they cannot fly through air." "accessed" "2026-09-08"
@v21 kernel.value.record "id" "sparrow" "publisher" "Smithsonian Institution" "title" "House Sparrow" "url" "https://qrius.si.edu/browse/object/10841863" "support" "Passer domesticus is classified within Aves. No universal claim about the flight ability of an individual sparrow is inferred." "accessed" "2026-09-08"
@v22 kernel.value.record "id" "plant-water" "publisher" "National Park Service" "title" "Desert Adaptations" "url" "https://www.nps.gov/teachers/classrooms/desert-adaptations.htm" "support" "Plants and animals need water to survive. This is a biological requirement, not an instruction to irrigate a particular plant." "accessed" "2026-09-08"
