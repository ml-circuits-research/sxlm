@v5626 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:626" "sourceId" "RO-063-06" "sourceDigest" "sha256:48f479879f18f69cc4fd917e4f949f172f91effc974f9be7cb404fda9edf0e3b" "sourceFile" "cases/benchmark_063.md"
@v5627 kernel.seq.make item "notifications" item "interface" item "search" item "favorites"
@v5628 kernel.seq.make
@v5629 kernel.value.record "answer" "I would group the feedback into four themes:\n\n1. **Speed and setup:** quick opening and easy initial setup are positive points.\n2. **Interface and accessibility:** the interface is praised as simple, but there is a request for larger text.\n3. **Search and organization:** favorites are appreciated, but old documents are difficult to find.\n4. **Notifications:** notifications are sometimes missing and sometimes duplicated.\n\nThe clear positive aspects are simplicity, speed, setup, and favorites. The recurring problem is notification reliability because two different comments report incorrect behavior in that area.\n\nThis sample does not establish how frequent the problems are across the entire user base." "requiredConcepts" $v5627 "forbiddenClaims" $v5628
@v5630 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
@v5631 kernel.seq.make item "core-only"
@v5632 kernel.seq.make item "assigned-train-visible" item "source-category:feedback-synthesis" item "domain:text-analysis" item "length:medium"
@v5633 kernel.value.record "expectedMinWords" 100 "expectedMaxWords" 230 "acceptableVariations" "The grouping may use three or four themes, but it must recognize both notification-related problems."
@v5634 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0626" "source" $v5626 "pool" "source-development" "category" "feedback-synthesis" "difficulty" "medium" "scoring" "semantic" "prompt" "You have the following eight comments about a fictional application:\n1. “It opens quickly.”\n2. “Sometimes I do not receive notifications.”\n3. “The interface is simple.”\n4. “Search has difficulty finding old documents.”\n5. “I like being able to save favorites.”\n6. “I would like larger text.”\n7. “I received two notifications for the same event.”\n8. “Initial setup was easy.”\n\nGroup the feedback into no more than four themes, state what is positive and which problem recurs. Do not invent frequencies beyond the eight comments. Maximum 220 words. Follow the requested format strictly." "reference" $v5629 "conversion" $v5630 "profiles" $v5631 "tags" $v5632 "constraints" $v5633 "reviewNotes" "Source policy: development-visible"
@v5635 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:627" "sourceId" "RO-063-07" "sourceDigest" "sha256:20a3e375d0fbb96fbdb168b8eb9958d0efb39b47ae986621ab06c9b326b84b47" "sourceFile" "cases/benchmark_063.md"
@v5636 kernel.seq.make
@v5637 kernel.seq.make
@v5638 kernel.value.record "answer" "Split the reading into two sessions of about 20 pages and leave a few minutes for review." "requiredConcepts" $v5636 "forbiddenClaims" $v5637
@v5639 kernel.value.record "method" "template-assisted" "reviewed" true "note" ""
