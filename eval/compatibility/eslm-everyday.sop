@v7092 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0788" "source" $v7084 "pool" "source-development" "category" "sentiment-classification" "difficulty" "easy" "scoring" "exact" "prompt" "Classify the tone as positive, negative, or neutral. Answer with one word: “I am very satisfied with the support.” Answer directly and do not add unrequested information." "reference" $v7087 "conversion" $v7088 "profiles" $v7089 "tags" $v7090 "constraints" $v7091 "reviewNotes" "Source policy: development-visible"
