@v27 kernel.value.empty
@v28 data.attach record $v27 key "id" value "family-vocabulary"
@v29 data.attach record $v28 key "publisher" value "Cambridge University Press"
@v30 data.attach record $v29 key "title" value "Siblings and in-laws: talking about family relationships"
