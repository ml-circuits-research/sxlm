@v8910 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0990" "source" $v8902 "pool" "source-development" "category" "translation" "difficulty" "easy" "scoring" "semantic" "prompt" "Translate this Romanian sentence into English: “Fisierul este prea mare.”" "reference" $v8905 "conversion" $v8906 "profiles" $v8907 "tags" $v8908 "constraints" $v8909 "reviewNotes" "Source policy: development-visible"
@v8911 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:991" "sourceId" "RO-100-01" "sourceDigest" "sha256:6e68a4935c3c6bfd06058ebb311f9b4a908ddf7c1c7d1256ae381d6209de21c9" "sourceFile" "cases/benchmark_100.md"
@v8912 kernel.seq.make
@v8913 kernel.seq.make
@v8914 kernel.value.record "answer" "Fixed expenses are 2,200 + 550 + 250 + 450 = **RON 3,450**. Variable expenses are 1,500 + 700 + 600 = **RON 2,800**. Including RON 500 in savings, the total allocation is **RON 6,750**.\n\nFrom RON 7,500 of income, **RON 750** remains unallocated.\n\nFixed expenses are 3,450 / 7,500, or approximately **46%** of net income.\n\nThe most obvious areas for a larger buffer, without reducing rent or the RON 500 savings, are variable expenses.\n\n**First option:** set a lower limit for going out by moderately reducing the frequency or average cost.\n\n**Second option:** track “miscellaneous purchases” separately. Because the category is broad, it may hide impulse purchases. A list and a short waiting period for nonessential purchases may reduce the amount.\n\nIt would be unsound to estimate exact savings from those changes without behavioral data. The supplied figures already show a RON 750 buffer.\n\nFor tracking, record the three variable categories separately each month rather than combining them. This will show whether the RON 750 buffer is real or whether irregular expenses were omitted from the fictional scenario. This analysis checks only the supplied arithmetic and budget structure; it does not estimate needs, returns, or investments. This calculation assumes no other debts, additional income, or expenses beyond those explicitly listed in the fictional scenario." "requiredConcepts" $v8912 "forbiddenClaims" $v8913
@v8915 kernel.value.record "method" "manual-reviewed" "reviewed" true "note" "English wording was reviewed against the source response-length metadata."
@v8916 kernel.seq.make item "core-only"
@v8917 kernel.seq.make item "assigned-train-visible" item "source-category:complex-everyday-task" item "domain:decision-and-synthesis" item "length:long"
@v8918 kernel.value.record "expectedMinWords" 214 "expectedMaxWords" 850 "acceptableVariations" "The answer may vary but must follow every constraint, use the supplied data, and not invent material information."
@v8919 kernel.value.record "format" "eslm-basic-everyday-eval-case" "id" "everyday-0991" "source" $v8911 "pool" "source-development" "category" "complex-everyday-task" "difficulty" "medium-hard" "scoring" "semantic" "prompt" "I have a fictional monthly budget. Net income: RON 7,500. Fixed expenses: rent 2,200, utilities 550, subscriptions and phone 250, transport 450. Average variable expenses: food 1,500, going out 700, miscellaneous purchases 600. I set aside RON 500 each month.\n\nI am not asking for financial or investment advice. Check the arithmetic, state how much remains, estimate what proportion of income goes to fixed expenses, and suggest two ordinary ways to create a larger buffer without changing rent or the RON 500 savings. Do not assume other debt or income. Maximum 650 words." "reference" $v8914 "conversion" $v8915 "profiles" $v8916 "tags" $v8917 "constraints" $v8918 "reviewNotes" "Source policy: development-visible"
@v8920 kernel.value.record "collection" "eslm-everyday-source.jsonl" "locator" "dataset.jsonl:992" "sourceId" "RO-100-02" "sourceDigest" "sha256:ca975c5ebbbbfec6ee3e6bb9c8c8c9e99f9e4fe6feb98bfee66cfb409b981d7d" "sourceFile" "cases/benchmark_100.md"
@v8921 kernel.seq.make
@v8922 kernel.seq.make
@v8923 kernel.value.record "answer" "Could you give a concrete example of the result you expect?" "requiredConcepts" $v8921 "forbiddenClaims" $v8922
